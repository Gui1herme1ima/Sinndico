NODE_ENV=development
PORT=5000

# Connection string PRIVILEGIADA (role "postgres" do Supabase — Project Settings > Database > Connect >
# Transaction pooler). Ignora Row Level Security (é superuser) — usar SÓ pra rodar migrations, nunca em
# runtime pela API. Usar o pooler (aws-...pooler.supabase.com:6543), não o host "db.<projeto>.supabase.co"
# direto: esse só resolve em IPv6 e trava com ETIMEDOUT em redes sem saída IPv6.
DATABASE_URL=postgresql://postgres.seu-projeto:sua_senha@aws-0-sua-regiao.pooler.supabase.com:6543/postgres

# Senha de uma role Postgres nova e restrita ("app_user"), criada pela migration
# 1700000000009_add-restricted-app-role-and-rls — gere uma senha forte antes de rodar essa migration.
APP_DB_PASSWORD=
# Connection string que a API usa em runtime pra tudo que é tenant-scoped (RLS ativo de verdade, porque
# essa role não tem BYPASSRLS). Mesmo host/porta do pooler acima, usuário "app_user.<projeto>".
APP_DATABASE_URL=postgresql://app_user.seu-projeto:sua_senha@aws-0-sua-regiao.pooler.supabase.com:6543/postgres

REDIS_URL=redis://localhost:6379

# Project Settings > API, no painel do Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGIN=http://localhost:5173
